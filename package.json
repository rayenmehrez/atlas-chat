{
  "name": "atlas-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/setup.mjs check",
    "update": "git pull --ff-only && npm ci --no-audit --no-fund && node scripts/setup.mjs update",
    "preview": "bash scripts/preview.sh",
    "dev": "wrangler dev --var ATLAS_PREVIEW:true",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "predeploy": "node scripts/setup.mjs preflight",
    "postinstall": "node scripts/setup.mjs prepare"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "AtlasChat: self-hosted Instagram DM automation for @rayen.mhz. A fork of FewChat (MIT).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rayenmehrez/atlas-chat.git"
  }
}
