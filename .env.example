# Your passwords and keys. `npm run setup` copies this file to .env, fills in the first three itself, and stores
# everything here encrypted in your Worker. Never commit .env and never paste its contents anywhere.

# Made for you by setup:
INBOUND_SECRET=
ADMIN_PASSWORD=
META_VERIFY_TOKEN=

# From your Meta app (setup asks for it): Instagram → API setup with Instagram login → Instagram app secret.
# This is a Worker secret. `npm run setup` stores it encrypted. It is not the Instagram user token.
META_APP_SECRET=

# Optional Instagram user token. Leave this blank to connect with Log in with Instagram (the usual path).
# Paste either kind, then run `npm run setup`. Setup checks it belongs to the account in fewchat.config.json,
# saves it in the database (settings.ig_token), and subscribes to DMs and comments.
# - IG…  Instagram Login long-lived user token from THIS Meta app. Weekly refresh renews it.
# - EA…  Unified Login Business Integration System User token. Sent to graph.facebook.com. Not refreshed weekly.
# It is NOT uploaded as a Worker secret: the Worker reads the token from the database.
# A short-lived token or a token from a different app will fail later.
# Scopes an Instagram Login token needs:
# instagram_business_basic, instagram_business_manage_messages, instagram_business_manage_comments.
# The app id is not a secret: pass it as `npm run setup -- --app-id=<Instagram app ID>`.
IG_ACCESS_TOKEN=

# Optional. Add any of these later, then run `npm run setup` again.
# ANTHROPIC_API_KEY: the AI replies (beta) and describing photos people send. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# ALERT_TOPIC: phone alerts through the free ntfy app. Pick a long random word and subscribe to it in the app.
ALERT_TOPIC=
# SKOOL_AUTH_TOKEN: only if you sell a Skool community (docs/AI.md).
SKOOL_AUTH_TOKEN=
# MANYCHAT_API_KEY: only if you also run Manychat on this account (CLAUDE.md, "Manychat").
MANYCHAT_API_KEY=
# REVIEW_PASSWORD: a second, read-only console login that only sees test conversations.
REVIEW_PASSWORD=
